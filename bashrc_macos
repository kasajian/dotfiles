# ============================================================
# bashrc_macos — macOS entry point (compatible with bash & zsh)
# Source this from ~/.zshrc, ~/.bashrc, or ~/.bash_profile (do NOT symlink it).
# Put machine-specific settings in the local file, after the source line.
# ============================================================

# Source system-wide bashrc when running under Bash
if [ -n "$BASH_VERSION" ] && [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# --- Homebrew ---
if [ -z "$HOMEBREW_PREFIX" ]; then
    if [ -f /opt/homebrew/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"      # Apple Silicon
    elif [ -f /usr/local/bin/brew ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"      # Intel
    fi
fi

# --- Bash Completion (Homebrew, Bash only) ---
if [ -n "$BASH_VERSION" ]; then
    if [ -f /opt/homebrew/etc/profile.d/bash_completion.sh ]; then
        . /opt/homebrew/etc/profile.d/bash_completion.sh
    elif [ -f /usr/local/etc/profile.d/bash_completion.sh ]; then
        . /usr/local/etc/profile.d/bash_completion.sh
    fi
fi

# --- macOS-specific PATH ---
case ":$PATH:" in
    *":/usr/local/sbin:"*) ;;
    *) export PATH="/usr/local/sbin:$PATH" ;;
esac

# --- Source the shared bashrc ---
if [ -f ~/dotfiles/bashrc ]; then
    . ~/dotfiles/bashrc
fi
